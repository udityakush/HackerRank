import java.util.Scanner;

public class Solution {

    public static void main(String[] args) throws IOException {

    Scanner  sc = new Scanner(System.in);

   

    int p = sc.nextInt();

    int d = sc.nextInt();

    int m = sc.nextInt();

    int s = sc.nextInt();

    int total=0;

    int count=0;

   

    while(p>=m ){

        if(total+p <=s){

            total+=p;

            count++;

            p=p-d;

        }

        else{

            break;

        }

    }

   

    if(total<s){

        while(total<s){

            total=total+m;

            count++;

           

        }

         

    }

   System.out.println(count-1);

    }

 

    }
